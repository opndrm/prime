<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.opndrm.buzzbot-guest-helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BUZZBOT_HELPER_PATH__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>OPENADAPT_PATH</key>
        <string>__OPENADAPT_CLI_PATH__</string>
        <key>OPENADAPT_RECORDINGS_DIR</key>
        <string>__OPENADAPT_RECORDINGS_DIR__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__BUZZBOT_ERROR_LOG_PATH__</string>
    <key>StandardOutPath</key>
    <string>__BUZZBOT_OUTPUT_LOG_PATH__</string>
</dict>
</plist>
