{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDream Prime GUI Linux VM design manifest",
  "type": "object",
  "required": ["schema_version", "status", "identity", "host", "guest", "default_exposure", "lifecycle", "non_goals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {
      "enum": [
        "design-only-no-assets-downloaded",
        "installer-provenance-verified-download-pending",
        "installer-downloaded-local-hash-verified"
      ]
    },
    "identity": {
      "type": "object",
      "required": ["name", "owner_surface", "purpose"]
    },
    "host": {
      "type": "object",
      "required": ["minimum_macos", "architecture", "framework", "required_entitlement", "hypervisor_framework"],
      "properties": {
        "framework": {"const": "Virtualization.framework"},
        "required_entitlement": {"const": "com.apple.security.virtualization"},
        "hypervisor_framework": {"const": "not-required-for-this-design"}
      }
    },
    "guest": {
      "type": "object",
      "required": ["architecture", "boot_model", "boot_loader", "graphics", "display", "assets"],
      "properties": {
        "architecture": {"const": "arm64"},
        "boot_loader": {"const": "VZEFIBootLoader"},
        "graphics": {"const": "VZVirtioGraphicsDeviceConfiguration"},
        "display": {"const": "VZVirtualMachineView"}
      }
    },
    "default_exposure": {
      "type": "object",
      "required": ["network", "shared_directories", "clipboard", "guest_keyboard_and_pointer", "host_desktop_capture", "credentials", "recording"],
      "properties": {
        "network": {"const": "disabled"},
        "shared_directories": {"const": "disabled"},
        "clipboard": {"const": "disabled"},
        "guest_keyboard_and_pointer": {"const": "disabled-until-explicit-owner-take-control"},
        "host_desktop_capture": {"const": "never"},
        "credentials": {"const": "none"},
        "recording": {"const": "unavailable"}
      }
    }
  },
  "additionalProperties": true
}
