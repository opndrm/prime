# Immutable tool layer for future Buzz Container task VMs.
#
# All third-party application artifacts below use their vendors' official Linux
# arm64 release URLs and a checked SHA-256. The task lifecycle remains offline;
# network access here exists only while an owner deliberately builds this image.
FROM docker.io/library/rust:1.97.1-slim-trixie@sha256:8e8cf8f7fd54a2d23d5a743b3a03f56e26b6c774276c33fa0595111704ebb15c

ARG HERDR_VERSION=0.8.0
ARG HERDR_SHA256=f647ac66468d9efbc642fe534fb284468f0aea60641606fc008dfc0d82a3ca87
ARG JCODE_VERSION=0.76.0
ARG JCODE_SHA256=605bc2361aeadacb2f1754c5118111181cf14e8b2eca1a42d6a5fe5ecb411a7e
ARG NODE_VERSION=22.23.2
ARG NODE_SHA256=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8
ARG PRIME_AGENT_VERSION=0.7.2
ARG PRIME_AGENT_SHA256=bc5471f2a626d727b88a45eb745fff93b10c554a3c4fc5912f25d8c64b987f5e

LABEL org.opencontainers.image.title="OpenDream Prime Buzz Container" \
      org.opencontainers.image.description="Pinned local Linux arm64 tool image for future isolated Buzz coding tasks; no task runtime service is included." \
      org.opencontainers.image.source="https://github.com/opndrm/prime" \
      org.opencontainers.image.version="0.2.0"

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    JCODE_NO_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Packages are required for the pinned terminal-tool releases. No credentials,
# model routes, GitHub configuration, application services, or project source
# are copied into the image.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        curl \
        git \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location \
        "https://github.com/herdrdev/herdr/releases/download/v${HERDR_VERSION}/herdr-linux-aarch64" \
        --output /tmp/herdr \
    && echo "${HERDR_SHA256}  /tmp/herdr" | sha256sum --check --strict \
    && install --mode=0755 /tmp/herdr /usr/local/bin/herdr \
    && rm -f /tmp/herdr

RUN curl --fail --silent --show-error --location \
        "https://github.com/1jehuang/jcode/releases/download/v${JCODE_VERSION}/jcode-linux-aarch64.tar.gz" \
        --output /tmp/jcode.tar.gz \
    && echo "${JCODE_SHA256}  /tmp/jcode.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/jcode.tar.gz --directory /tmp \
    && install --mode=0755 /tmp/jcode-linux-aarch64 /usr/local/bin/jcode \
    && rm -f /tmp/jcode.tar.gz /tmp/jcode-linux-aarch64

# Prime Agent requires Node.js 22.8 or later. Install a pinned official Linux
# arm64 Node.js release, then use the same verified package route as Prime
# Agent's official installer. Lifecycle scripts are disabled deliberately: its
# postinstall otherwise has optional tool/kernel bootstrap paths. This image
# does not launch Prime Agent, a daemon, a model provider, or a session.
RUN curl --fail --silent --show-error --location \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
        --output /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --xz --file /tmp/node.tar.xz --strip-components=1 --directory /usr/local \
    && test "$(node --version)" = "v${NODE_VERSION}" \
    && rm -f /tmp/node.tar.xz

RUN curl --fail --silent --show-error --location \
        "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v${PRIME_AGENT_VERSION}/prime-agent-${PRIME_AGENT_VERSION}.tgz" \
        --output /tmp/prime-agent.tgz \
    && echo "${PRIME_AGENT_SHA256}  /tmp/prime-agent.tgz" | sha256sum --check --strict \
    && NPM_CONFIG_CACHE=/tmp/npm-cache \
       NPM_CONFIG_IGNORE_SCRIPTS=true \
       NPM_CONFIG_AUDIT=false \
       NPM_CONFIG_FUND=false \
       npm install --global --ignore-scripts --no-audit --no-fund /tmp/prime-agent.tgz \
    && test -x /usr/local/bin/prime-agent \
    && node --check "$(readlink -f /usr/local/bin/prime-agent)" \
    && rm -f /tmp/prime-agent.tgz \
    && rm -rf /tmp/npm-cache

COPY buzz-container-image-manifest.json /usr/local/share/buzz-container/manifest.json

RUN useradd --create-home --shell /bin/bash opndrm

USER opndrm
WORKDIR /workspace

CMD ["bash"]
