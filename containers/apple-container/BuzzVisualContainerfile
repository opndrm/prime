# Build-only visual proof image. Separate from the immutable headless task image.
# This image deliberately carries the graphical terminal layer required to view
# an isolated HERDR workspace. It never replaces the Captain's host layout.
FROM opndrm-prime/buzz-container:0.2.0

ARG WEZTERM_VERSION=20240203-110809-5046fc22
ARG WEZTERM_SHA256=351f8791c6e9561d687afa63834a2132de84800dad6e7c3d035cc6518d6c3744
ARG HERDR_LICENSE_SHA256=c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4
ARG WEZTERM_LICENSE_SHA256=37db33bbbd7348969eda397b89a16f252d56c1ca7481b6ccaf56ccdcbab5dcca

USER root
RUN apt-get update \
    && apt-get install --no-install-recommends -y fluxbox imagemagick python3 x11-apps x11-utils xvfb \
    && curl --fail --silent --show-error --location \
        "https://github.com/wez/wezterm/releases/download/${WEZTERM_VERSION}/wezterm-${WEZTERM_VERSION}.Debian12.arm64.deb" \
        --output /tmp/wezterm.deb \
    && echo "${WEZTERM_SHA256}  /tmp/wezterm.deb" | sha256sum --check --strict \
    && apt-get install --no-install-recommends -y /tmp/wezterm.deb \
    && test -x /usr/bin/wezterm \
    && curl --fail --silent --show-error --location \
        "https://raw.githubusercontent.com/herdrdev/herdr/v0.8.0/LICENSE" \
        --output /tmp/herdr-LICENSE \
    && echo "${HERDR_LICENSE_SHA256}  /tmp/herdr-LICENSE" | sha256sum --check --strict \
    && install -D -m 0644 /tmp/herdr-LICENSE /usr/local/share/buzz-container/licenses/herdr-LICENSE \
    && curl --fail --silent --show-error --location \
        "https://raw.githubusercontent.com/wez/wezterm/${WEZTERM_VERSION}/LICENSE.md" \
        --output /tmp/wezterm-LICENSE.md \
    && echo "${WEZTERM_LICENSE_SHA256}  /tmp/wezterm-LICENSE.md" | sha256sum --check --strict \
    && install -D -m 0644 /tmp/wezterm-LICENSE.md /usr/local/share/buzz-container/licenses/wezterm-LICENSE.md \
    && rm -f /tmp/wezterm.deb /tmp/herdr-LICENSE /tmp/wezterm-LICENSE.md \
    && rm -rf /var/lib/apt/lists/*
COPY visual-frame-server.py /usr/local/lib/buzz-container/visual-frame-server.py
COPY visual-proof-entrypoint.sh /usr/local/lib/buzz-container/visual-proof-entrypoint.sh
COPY buzz-visual-container-image-manifest.json /usr/local/share/buzz-container/visual-manifest.json
RUN chmod 0755 /usr/local/lib/buzz-container/visual-proof-entrypoint.sh \
    && mkdir -p /run/buzz-container \
    && chown -R opndrm:opndrm /run/buzz-container /usr/local/lib/buzz-container
USER opndrm
ENTRYPOINT ["/usr/local/lib/buzz-container/visual-proof-entrypoint.sh"]
